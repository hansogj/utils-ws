{
  "name": "@hansogj/utils-ws",
  "version": "0.1.14",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "circularity:check": "madge  --warning --extensions ts,tsx ./packages",
    "clean": "pnpm -r  clean  && rm -rf node_modules *.tgz surefire-reports",
    "generate": "node -- ./scripts/generate.js",
    "lint": "npx eslint packages/**/src",
    "pre-commit": "pnpm run ws:ts && pnpm run circularity:check && pnpm run lint && pnpm test --coverage && pnpm run harness:test",
    "prepack": "rm -f *.tgz && pnpm run build",
    "prettier:write": "prettier --write 'packages/**/*.{ts,tsx,js,jsx}'",
    "test:ci": "pnpm run test --ci  --reporters=default --reporters=jest-junit",
    "test:coverage": "pnpm run test:ci --coverage",
    "test:watch": "pnpm run test --watch",
    "test": "NODE_ICU_DATA=node_modules/full-icu jest --runInBand",
    "harness:build": "pnpm -r --filter './harness/*' --filter './apps/*' build",
    "harness:test": "pnpm -r --filter './apps/*' test",
    "harness:e2e": "pnpm --filter e2e test",
    "web-ts": "pnpm --filter web-ts",
    "web-cs": "pnpm --filter web-cs",
    "web-js": "pnpm --filter web-js",
    "ws:commit:tag:push": "git commit -a -m \"${npm_config_tag}\" --no-verify && git tag -a ${npm_config_tag} -m \"${npm_config_tag}\" && git push --follow-tags",
    "ws:local-dependencies": "pnpm list -r --depth 0",
    "ws:pack": "rm -f *.tgz && pnpm run build && pnpm -r exec pnpm pack",
    "ws:version:list": "pnpm -r exec ../../scripts/ws-scripts.sh version",
    "ws:ts": "pnpm -r ts",
    "ws:version:set:all": "pnpm -r exec ../../scripts/ws-scripts.sh set-version ${npm_config_bump}",
    "update": "npx npm-check-updates --peer -i -t  minor && pnpm run post:update",
    "update:majors": "npx npm-check-updates --peer -i -t latest && pnpm run post:update",
    "post:update": "rm -rfv node_modules && pnpm i"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.4",
    "eslint": "9.39.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-config": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "jest-transform-stub": "2.0.0",
    "jsdom": "30.0.1",
    "madge": "8.0.0",
    "prettier": "3.9.6",
    "raw-loader": "4.0.2",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<4.1.2": ">=4.1.2",
      "postcss@<8.5.18": ">=8.5.18",
      "ws@<8.20.1": ">=8.20.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "uuid@<11.1.1": ">=11.1.1"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --ext .ts,.tsx src/ --ignore-path .gitignore --fix"
    ]
  },
  "jest-junit": {
    "outputDirectory": "./surefire-reports"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/packages/**/*.spec.{ts,tsx,js}"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/apps/",
      "<rootDir>/harness/"
    ],
    "collectCoverageFrom": [
      "packages/*/src/**/*.{ts,tsx}",
      "!packages/*/src/**/*.spec.{ts,tsx}",
      "!packages/*/src/**/index.ts",
      "!packages/git-prompt/src/{co,commit,retry,utils}.ts",
      "!packages/immer-reduxer/src/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "engines": {
    "node": "^18 || ^20 || ^21 || ^22 || ^25"
  },
  "volta": {
    "node": "25.3.0"
  },
  "packageManager": "pnpm@10.33.0"
}
